.signal-time-stage {
  width: 100%;
}

.signal-time-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.signal-time-title {
  min-width: 0;
}

.signal-time-title > span {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  color: #77dcff;

  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
}

.signal-time-title h3 {
  margin: 7px 0 0;

  color: #fff;

  font-size: 22px;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: -.025em;
}

.signal-time-title p {
  margin: 8px 0 0;

  color: #fff;

  font-size: 12px;
  font-weight: 900;
  letter-spacing: .08em;
}

.signal-time-context {
  color: rgba(196, 220, 235, .55);

  font-size: 10px;
  font-weight: 800;
  letter-spacing: .06em;

  text-align: right;
}

.signal-time-venue {
  display: flex;
  align-items: center;
  gap: 11px;

  margin-top: 18px;
  padding: 12px 14px;

  border:
    1px solid rgba(86, 204, 255, .14);

  border-radius: 15px;

  background:
    linear-gradient(
      100deg,
      rgba(12, 28, 42, .74),
      rgba(7, 17, 27, .46)
    );
}

.signal-time-venue-icon {
  display: grid;
  place-items: center;

  width: 34px;
  height: 34px;
  flex: 0 0 34px;

  border-radius: 50%;

  color: #7ee3ff;

  background:
    rgba(62, 186, 255, .09);

  box-shadow:
    0 0 18px
    rgba(47, 175, 255, .08);
}

.signal-time-venue > div:last-child {
  min-width: 0;

  display: flex;
  flex-direction: column;
}

.signal-time-venue small {
  color: rgba(109, 220, 255, .70);

  font-size: 8px;
  font-weight: 900;
  letter-spacing: .12em;
}

.signal-time-venue strong {
  margin-top: 2px;

  overflow: hidden;

  color: #fff;

  font-size: 13px;
  font-weight: 850;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.signal-time-venue span {
  margin-top: 2px;

  overflow: hidden;

  color: rgba(196, 218, 232, .52);

  font-size: 10px;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.signal-time-options {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 12px;

  margin-top: 16px;
}

.signal-time-option {
  position: relative;
  isolation: isolate;

  min-height: 174px;

  padding: 18px 16px;

  overflow: hidden;

  border:
    1px solid rgba(102, 197, 239, .13);

  border-radius: 19px;

  color: #fff;

  text-align: left;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(66, 176, 239, .09),
      transparent 46%
    ),
    linear-gradient(
      145deg,
      rgba(13, 27, 40, .96),
      rgba(7, 15, 24, .96)
    );

  box-shadow:
    0 14px 34px
    rgba(0, 0, 0, .20);

  cursor: pointer;

  transition:
    transform .28s ease,
    border-color .28s ease,
    box-shadow .28s ease,
    background .28s ease;
}

.signal-time-option:hover:not(:disabled) {
  transform: translateY(-4px);

  border-color:
    rgba(105, 220, 255, .28);
}

.signal-time-option:disabled {
  cursor: default;
}

.signal-time-option-selected {
  transform: translateY(-3px);

  border-color:
    rgba(107, 226, 255, .72);

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(62, 204, 255, .17),
      transparent 48%
    ),
    linear-gradient(
      145deg,
      rgba(12, 34, 49, .98),
      rgba(6, 17, 27, .98)
    );

  box-shadow:
    0 0 0 1px
    rgba(100, 222, 255, .10),
    0 0 32px
    rgba(53, 190, 255, .12),
    0 18px 36px
    rgba(0, 0, 0, .26);
}

.signal-time-option-energy {
  position: absolute;
  inset: 0;
  z-index: -1;

  opacity: 0;

  background:
    linear-gradient(
      110deg,
      transparent 20%,
      rgba(116, 228, 255, .14),
      transparent 74%
    );

  transform: translateX(-80%);

  pointer-events: none;
}

.signal-time-option-selected
.signal-time-option-energy {
  opacity: 1;

  animation:
    signal-time-energy 1.8s
    linear
    infinite;
}

.signal-time-option-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  color: rgba(128, 220, 255, .72);
}

.signal-time-option-top span {
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .12em;
}

.signal-time-option > strong {
  display: block;

  margin-top: 28px;

  color: #fff;

  font-size: 25px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: -.035em;
}

.signal-time-option > small {
  display: block;

  margin-top: 10px;

  color: rgba(197, 220, 234, .48);

  font-size: 8px;
  font-weight: 850;
  letter-spacing: .10em;
}

.signal-time-option-selected > small {
  color: #84e6ff;
}

.signal-time-check {
  position: absolute;
  right: 13px;
  bottom: 13px;

  display: grid;
  place-items: center;

  width: 30px;
  height: 30px;

  border-radius: 50%;

  color: #07131d;

  background: #8be8ff;

  box-shadow:
    0 0 20px
    rgba(94, 217, 255, .28);
}

.signal-time-vote-pulse {
  position: absolute;
  inset: 5px;

  border:
    1px solid rgba(119, 228, 255, .42);

  border-radius: 16px;

  pointer-events: none;

  animation:
    signal-time-pulse 1.6s
    ease-out
    infinite;
}

.signal-time-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  margin-top: 15px;

  color: rgba(146, 217, 241, .55);

  font-size: 9px;
  font-weight: 750;
}

.signal-time-footer svg {
  color: #70dbff;
}

@keyframes signal-time-energy {
  from {
    transform: translateX(-90%);
  }

  to {
    transform: translateX(90%);
  }
}

@keyframes signal-time-pulse {
  0% {
    opacity: .18;
    transform: scale(.985);
  }

  48% {
    opacity: .72;
  }

  100% {
    opacity: 0;
    transform: scale(1.035);
  }
}

@media (max-width: 760px) {
  .signal-time-options {
    grid-template-columns: 1fr;
  }

  .signal-time-option {
    min-height: 132px;
  }
}

/* ============================================================
   G4.12-R3B-2A-4B-1
   VENUE + TIME / SIGNAL LIVE RAIL RESULT COMPOSITION
   ============================================================ */

.signal-time-lock-diagnostic {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 224px;
  margin-top: 18px;
  padding: 24px 26px;
  border: 1px solid rgba(112, 216, 255, .2);
  border-radius: 22px;
  background:
    radial-gradient(
      circle at 18% 18%,
      rgba(57, 187, 255, .13),
      transparent 34%
    ),
    linear   adient(
      145deg,
      rgba(13, 27, 40, .96),
      rgba(6, 15, 24, .94)
    );
  box-shadow:
    0 24px 70px rgba(0, 0, 0, .32),
    inset 0 1px 0 rgba(255, 255, 255, .05);
}

.signal-time-lock-diagnostic::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: inherit;
  background:
    linear-gradient(
      110deg,
      transparent 20%,
      rgba(105, 222, 255, .08) 46%,
      transparent 70%
    );
  transform: translateX(-100%);
  animation:
    signal-time-result-sweep 2.6s ease-in-out infinite;
}

.signal-time-lock-diagnostic > span:first-child {
  position: relative;
  z-index: 1;
  margin-bottom: 12px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .15em;
  color: rgba(111, 224, 255, .96);
}

.signal-time-lock-diagnostic > strong {
  position: relative;
  z-index: 1;
  display: block;
  color: #fff;
}

.signal-time-lock-diagnostic > strong:nth-of-type(1) {
  max-width: 460px;
  font-size: clamp(22px, 2.8vw, 34px);
  line-height: 1.02;
  letter-spacing: -.035em;
}

.signal-time-lock-diagnostic > small:nth-of-type(1) {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 460px;
  margin-top: 7px;
  color: rgba(221, 231, 239, .62);
  font-size: 12px;
  line-height: 1.45;
}

.signal-time-lock-diagnostic > span:nth-of-type(2) {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 22px;
  color: rgba(255, 255, 255, .52);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
}

.signal-time-lock-diagnostic > strong:nth-of-type(2) {
  margin-top: 4px;
  font-size: clamp(26px, 3.2vw, 40px);
  line-height: 1;
  letter-spacing: -.04em;
  text-shadow:
    0 0 24px rgba(92, 211, 255, .18);
}

.signal-time-lock-diagnostic > small:nth-of-type(2) {
  position: relative;
  z-index: 1;
  align-self: flex-start;
  margin-top: 18px;
  padding: 7px 10px;
  border: 1px solid rgba(101, 220, 255, .18);
  border-radius: 999px;
  background: rgba(64, 197, 255, .07);
  color: rgba(199, 239, 255, .9);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .11em;
}

.signal-time-live-rail {
  position: relative;
  overflow: hidden;
  min-height: 224px;
  margin-top: 12px;
  padding: 17px;
  border: 1px solid rgba(112, 216, 255, .16);
  border-radius: 22px;
  background:
    radial-gradient(
      circle at 90% 10%,
      rgba(57, 187, 255, .1),
      transparent 34%
    ),
    rgba(7, 17, 27, .84);
  box-shadow:
    0 24px 70px rgba(0, 0, 0, .25),
    inset 0 1px 0 rgba(255, 255, 255, .04);
}

.signal-time-live-rail::after {
  content: "";
  position: absolute;
  top: 0;
  left: 12%;
  width: 42%;
  height: 1px;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(110, 225, 255, .9),
      transparent
    );
  filter: drop-shadow(
    0 0 7px rgba(90, 218, 255, .72)
  );
  animation:
    signal-time-rail-current 2.1s ease-in-out infinite;
}

.signal-time-live-rail-heading {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 11px;
  padding: 0 3px;
}

.signal-time-live-rail-heading span {
  color: rgba(105, 222, 255, .96);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
}

.signal-time-live-rail-heading strong {
  color: rgba(255, 255, 255, .56);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.signal-time-live-rail .signal-live-rail {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 7px;
}

.signal-time-live-rail .signal-live-rail-person {
  min-height: 42px;
  margin: 0;
}

.signal-time-live-rail .arrival-avatar-wrap {
  flex: 0 0 auto;
}

.signal-time-live-rail .signal-live-rail-copy {
  min-width: 0;
  flex: 1;
}

.signal-time-live-rail .signal-live-rail-copy strong {
  display: block;
  overflow: hidden;
  color: rgba(255, 255, 255, .9);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .055em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal-time-live-rail .signal-live-rail-copy small {
  display: block;
  margin-top: 2px;
  color: rgba(204, 221, 232, .55);
  font-size: 10px;
}

.signal-time-vote-status {
  flex: 0 0 auto;
  padding: 4px 7px;
  border: 1px solid rgba(255, 255, 255, .08);
  border-radius: 999px;
  color: rgba(255, 255, 255, .42);
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .08em;
}

.signal-time-vote-status-winner {
  border-color: rgba(95, 221, 255, .28);
  background: rgba(70, 200, 255, .08);
  color: rgba(150, 235, 255, .96);
  box-shadow:
    0 0 16px rgba(62, 205, 255, .08);
}

.signal-time-live-rail-overflow {
  margin-top: 2px;
}

@keyframes signal-time-result-sweep {
  0% {
    transform: translateX(-115%);
    opacity: 0;
  }

  35% {
    opacity: 1;
  }

  70%,
  100% {
    transform: translateX(150%);
    opacity: 0;
  }
}

@keyframes signal-time-rail-current {
  0% {
    transform: translateX(-80%);
    opacity: .2;
  }

  50% {
    opacity: 1;
  }

  100% {
    transform: translateX(190%);
    opacity: .2;
  }
}

@media (min-width: 760px) {
  .signal-time-lock-diagnostic {
    width: calc(50% - 6px);
    min-height: 250px;
    margin-top: 18px;
  }

  .signal-time-live-rail {
    width: calc(50% - 6px);
    min-height: 250px;
    margin-top: -250px;
    margin-left: calc(50% + 6px);
  }
}

@media (max-width: 759px) {
  .signal-time-lock-diagnostic,
  .signal-time-live-rail {
    width: 100%;
  }
}

/* ============================================================
   G4.12-R3B-2B-4C — GOOGLE REVIEW RUSH
   ============================================================ */

.signal-time-review-stage {
  position: relative;
  width: 100%;
  min-height: 112px;
  margin-top: 12px;
  overflow: hidden;
}

.signal-time-review {
  position: relative;
  overflow: hidden;
  min-height: 108px;
  padding: 14px 16px 13px;
  border:
    1px solid rgba(255, 211, 89, .14);
  border-radius: 18px;
  background:
    radial-gradient(
      circle at 88% 10%,
      rgba(255, 203, 79, .08),
      transparent 36%
    ),
    linear-gradient(
      135deg,
      rgba(15, 23, 31, .96),
      rgba(7, 15, 23, .92)
    );
  box-shadow:
    0 20px 55px rgba(0, 0, 0, .24),
    inset 0 1px 0 rgba(255, 255, 255, .04);
}

.signal-time-review::after {
  content: "";
  position: absolute;
  top: 0;
  left: -35%;
  width: 32%;
  height: 1px;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 219, 106, .96),
      transparent
    );
  filter:
    drop-shadow(
      0 0 8px rgba(255, 213, 85, .65)
    );
  animation:
    signal-review-current 1.5s
    ease-in-out infinite;
}

.signal-time-review-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.signal-time-review-top span {
  color: rgba(255, 255, 255, .46);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .13em;
}

.signal-time-review-top strong {
  color: #ffd35f;
  font-size: 13px;
  letter-spacing: .08em;
  text-shadow:
    0 0 16px rgba(255, 204, 63, .18);
}

.signal-time-review p {
  position: relative;
  z-index: 2;
  display: -webkit-box;
  overflow: hidden;
  margin: 9px 0 8px;
  color: rgba(244, 248, 251, .88);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.signal-time-review-author {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8px;
}

.signal-time-review-author strong {
  color: rgba(127, 224, 255, .94);
  font-size: 10px;
  font-weight: 900;
}

.signal-time-review-author span {
  color: rgba(255, 255, 255, .34);
  font-size: 9px;
  font-weight: 700;
}

@keyframes signal-review-current {
  0% {
    transform: translateX(0);
    opacity: 0;
  }

  25% {
    opacity: 1;
  }

  100% {
    transform: translateX(430%);
    opacity: 0;
  }
}

@media (min-width: 760px) {
  .signal-time-review-stage {
    margin-top: 14px;
  }
}
